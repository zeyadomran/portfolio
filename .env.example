# Optional. Copy to .env.local for local builds, or configure these in Vercel
# for the intended environment. Use only each provider's verification token.
# Read by build tooling; keep these names without a VITE_ prefix and rebuild
# after changes. Verification tokens appear in the generated HTML metadata.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Vercel supplies VERCEL_ENV automatically. For a local preview-indexing check,
# set VERCEL_ENV=preview before building (noindex and an empty sitemap).
