{
  "name": "zeyad-omran-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "yarn": "1.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "start": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests *.json *.mjs *.ts *.md index.html",
    "test": "tsx --test tests/static-build.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "prettier": "^3",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@tailwindcss/vite": "4.3.3",
    "tsx": "4.23.13",
    "typescript-eslint": "8.70.0",
    "@eslint/js": "^9.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.12.0"
  },
  "type": "module"
}
